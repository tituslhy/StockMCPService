{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/pytest -q)",
      "Bash(.venv/bin/ruff check *)",
      "Bash(.venv/bin/mypy .)",
      "Bash(.venv/bin/isort --check-only .)",
      "Bash(.venv/bin/python -c ' *)",
      "Bash(.venv/bin/isort --check-only tools/price_history.py tests/test_price_history.py)",
      "Bash(echo \"isort exit=$?\")",
      "Bash(.venv/bin/mypy tools/price_history.py tests/test_price_history.py)",
      "Bash(.venv/bin/ruff format *)",
      "Bash(.venv/bin/pytest tests/test_price_history.py -q)",
      "Bash(PYTHONPATH=. .venv/bin/python __TRACKED_VAR__/nan_check.py)",
      "Bash(xargs -I{} sh -c 'echo ===={}====; cat {}')",
      "Bash(.venv/bin/pytest tests/test_portfolio.py -q)",
      "Bash(.venv/bin/coverage report *)",
      "Bash(rm -f .coverage)",
      "Bash(.venv/bin/python -m coverage run -m pytest -q tests/test_technical_analysis.py)",
      "Bash(sed -n '110,145p' tools/price_history.py)",
      "Bash(sed -n '400,430p' tools/technical_analysis.py)"
    ]
  }
